{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"],
      "next-intl":            ["./src/compat/intl.ts"],
      "next-intl/server":     ["./src/compat/intl.ts"],
      "next-intl/routing":    ["./src/compat/routing.ts"],
      "next-intl/navigation": ["./src/compat/routing.ts"],
      "next/navigation":      ["./src/compat/navigation.ts"],
      "next/link":            ["./src/compat/link.ts"],
      "next/cache":           ["./src/compat/cache.ts"],
      "next/image":           ["./src/compat/image.ts"],
      "next/headers":         ["./src/compat/headers.ts"],
      "next-themes":          ["./src/compat/next-themes.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
